NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Server only: account progress writes and the invitation-only reading league.
SUPABASE_SECRET_KEY=

# Server only: Ollama must listen on loopback. AI requires a signed-in account.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma3:4b
OLLAMA_VISION_MODEL=gemma3:4b

# Legacy OpenAI-compatible endpoint names remain supported.
QAZAQDOS_AI_BASE_URL=
QAZAQDOS_CHAT_MODEL=
QAZAQDOS_AI_KEY=
QAZAQDOS_VISION_MODEL=
QAZAQDOS_TEACHER_EMAILS=teacher@example.com
