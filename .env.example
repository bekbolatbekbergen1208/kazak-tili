NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Server only: account progress writes and the invitation-only reading league.
SUPABASE_SECRET_KEY=

# Server only: Ollama must listen on loopback. AI requires a signed-in account.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma3:4b
OLLAMA_VISION_MODEL=gemma3:4b

# Legacy OpenAI-compatible endpoint names remain supported.
QAZAQDOS_AI_BASE_URL=
QAZAQDOS_CHAT_MODEL=
QAZAQDOS_AI_KEY=
QAZAQDOS_VISION_MODEL=
QAZAQDOS_TEACHER_EMAILS=teacher@example.com

# Literary Intelligence: optional local embedding model (must return 768 dimensions).
QAZAQDOS_EMBEDDING_MODEL=embeddinggemma
# Corpus administration also allows app_metadata.role = admin or corpus_editor.
QAZAQDOS_CORPUS_ADMIN_EMAILS=

# Server only: optional Kazakh STT adapter. GET must advertise languages:["kk"].
# POST accepts multipart file + language=kk, returns text, language, optional confidence 0..1.
# Requires ffprobe on the server. Disabled by default; never stores recordings permanently.
SONG_STT_URL=
SONG_STT_API_KEY=
SONG_STT_MODEL=
SONG_STT_KAZAKH_ENABLED=false
